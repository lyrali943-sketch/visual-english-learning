# ============================================================================
# Visual English Studio — AI provider configuration
#
# Copy this file to ".env" and fill in your own values:
#   cp .env.example .env
#
# IMPORTANT: .env is read ONLY by the Node server (server/*.mjs). The browser
# never sees these values, and .env must never be committed to git.
# ============================================================================

# --- Required for real AI analysis -----------------------------------------
# Leave empty to run in demo mode: the app still works end-to-end and shows
# clearly-labelled sample content (a yogurt-bowl lesson) instead of a real
# analysis of your photo.
VES_AI_API_KEY=

# Any OpenAI-compatible /chat/completions endpoint with vision support.
#   OpenAI                  https://api.openai.com/v1
#   DeepSeek                https://api.deepseek.com/v1
#   Moonshot / Kimi         https://api.moonshot.cn/v1
#   Gemini (OpenAI compat)  https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama (local)          http://localhost:11434/v1
#   LM Studio (local)       http://localhost:1234/v1
VES_AI_BASE_URL=https://api.openai.com/v1

# A vision-capable model id, e.g. gpt-4o-mini, glm-4v-flash, gemini-1.5-flash.
VES_AI_MODEL=gpt-4o-mini

# Free-form label shown in the interface when the provider is active.
VES_AI_PROVIDER=openai-compatible

# --- Production server ------------------------------------------------------
# Port used by "npm start" (the bundled Node server). Vite dev uses 5173.
PORT=8080
